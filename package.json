{
  "name": "crud-pokeapi",
  "version": "1.0.0",
  "description": "CRUD de estadísticas Pokémon con conexión a PokeAPI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node scripts/seed-gen1.js",
    "test": "node tests/run.js",
    "test:smoke": "node tests/run.js --suite=smoke",
    "test:regression": "node tests/run.js --suite=regression",
    "test:live": "node tests/live.js"
  },
  "engines": { "node": ">=22" },
  "keywords": ["pokeapi", "pokemon", "crud"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  }
}
