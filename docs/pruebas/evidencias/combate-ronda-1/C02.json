    {
      "request": {
        "method": "GET",
        "route": "/combate.html"
      },
      "response": {
        "status": 200,
        "contentType": "text/html; charset=UTF-8",
        "body": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Combate Pokémon - CRUD PokeAPI</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/css/style.css\">\n  <link rel=\"stylesheet\" href=\"/css/combate.css\">\n</head>\n<body>\n  <div class=\"app\">\n    <header class=\"header\">\n      <div class=\"header-content\">\n        <img src=\"https://raw.githubusercontent.com/PokeAPI/media/master/logo/pokeapi_256.png\" alt=\"PokeAPI\" class=\"logo\">\n        <div>\n          <h1>Combate Pokémon</h1>\n          <p>Combate por turnos con los 151 Pokémon de la Gen 1 guardados en el proyecto</p>\n        </div>\n        <a href=\"/\" class=\"header-link\">Volver al CRUD</a>\n      </div>\n    </header>\n\n    <main class=\"main\">\n      <section id=\"setupSection\" class=\"card\">\n        <h2>Preparar combate</h2>\n        <p class=\"hint\">Elige tu Pokémon y el Pokémon salvaje entre los registros de la API del proyecto.\n          El salvaje elegirá sus ataques al azar.</p>\n        <div id=\"setupError\" class=\"battle-alert hidden\" role=\"alert\"></div>\n\n        <div class=\"setup-grid\">\n          <div class=\"setup-side\">\n            <label for=\"p1Select\">Tu Pokémon</label>\n            <select id=\"p1Select\"></select>\n            <div id=\"p1Preview\" class=\"preview\"></div>\n          </div>\n          <div class=\"setup-vs\">VS</div>\n          <div class=\"setup-side\">\n            <label for=\"p2Select\">Pokémon salvaje</label>\n            <select id=\"p2Select\"></select>\n            <div id=\"p2Preview\" class=\"preview\"></div>\n          </div>\n        </div>\n\n        <div class=\"setup-actions\">\n          <button type=\"button\" id=\"randomBtn\" class=\"secondary\">Salvaje aleatorio</button>\n          <button type=\"button\" id=\"startBtn\">¡A combatir!</button>\n        </div>\n      </section>\n\n      <section id=\"battleSection\" class=\"hidden\">\n        <div class=\"gb-frame\">\n          <div class=\"gb-screen\">\n            <div id=\"scene\" class=\"scene\">\n              <div id=\"enemyInfo\" class=\"info-box enemy-info\"></div>\n              <div class=\"platform enemy-platform\"></div>\n              <img id=\"enemySprite\" class=\"sprite enemy-sprite\" alt=\"\">\n              <div class=\"platform player-platform\"></div>\n              <img id=\"playerSprite\" class=\"sprite player-sprite\" alt=\"\">\n              <div id=\"playerInfo\" class=\"info-box player-info\"></div>\n            </div>\n\n            <div id=\"textBox\" class=\"text-box\">\n              <p id=\"message\" class=\"message\" aria-live=\"polite\"></p>\n              <span id=\"advance\" class=\"advance hidden\" aria-hidden=\"true\">▼</span>\n              <div id=\"commandMenu\" class=\"menu command-menu hidden\">\n                <button type=\"button\" class=\"menu-option\" data-command=\"fight\">LUCHAR</button>\n                <button type=\"button\" class=\"menu-option\" data-command=\"run\">HUIR</button>\n              </div>\n              <div id=\"moveMenu\" class=\"move-menu hidden\">\n                <div id=\"moveGrid\" class=\"menu move-grid\"></div>\n                <div id=\"moveInfo\" class=\"move-info\"></div>\n              </div>\n              <div id=\"endMenu\" class=\"menu command-menu hidden\">\n                <button type=\"button\" class=\"menu-option\" data-command=\"rematch\">REVANCHA</button>\n                <button type=\"button\" class=\"menu-option\" data-command=\"new\">NUEVO</button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div id=\"battleError\" class=\"battle-alert hidden\" role=\"alert\"></div>\n        <div id=\"resultBanner\" class=\"result-banner hidden\" role=\"status\"></div>\n        <p class=\"hint controls-hint\">Controles: clic, o teclado con flechas, Enter/Z para aceptar y Esc/X para volver.</p>\n\n        <details class=\"card log-card\">\n          <summary>Registro del combate y cálculo del daño</summary>\n          <ol id=\"battleLog\" class=\"battle-log\" reversed></ol>\n        </details>\n      </section>\n\n      <section class=\"card\">\n        <h2>Reglas aplicadas</h2>\n        <div id=\"rulesBox\" class=\"rules-box hint\">Cargando reglas...</div>\n      </section>\n    </main>\n\n    <div id=\"toast\" class=\"toast hidden\"></div>\n  </div>\n\n  <script src=\"/js/combate.js\"></script>\n</body>\n</html>\n"
      },
      "durationMs": 7
    }
